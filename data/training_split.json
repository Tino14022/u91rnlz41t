{
  "_comment": "Winter-bulk weekly split, agreed 2026-10-12: upper body only, legs kept light, no running. weekday keys are Python weekday() ints: Mon=0..Sun=6. A workout_plan.json entry for today overrides this. See data/README.md.",
  "schedule": {
    "0": "push",
    "1": "pull",
    "2": "arms_shoulders",
    "3": "rest",
    "4": "push",
    "5": "pull",
    "6": "rest"
  },
  "append_finisher_to": ["push", "pull"],
  "templates": {
    "push": {
      "name": "Upper Push",
      "exercises": [
        {"name": "Incline Dumbbell Bench Press", "target_sets": 4, "target_reps": "8-10"},
        {"name": "Dumbbell Bench Press", "target_sets": 4, "target_reps": "8-10"},
        {"name": "Cable or Suspension Chest Fly", "target_sets": 3, "target_reps": "12-15"},
        {"name": "Dumbbell Lateral Raise", "target_sets": 3, "target_reps": "12-15"},
        {"name": "Triceps Press-down", "target_sets": 3, "target_reps": "10-12"},
        {"name": "Cable Overhead Triceps Extension", "target_sets": 3, "target_reps": "10-12"}
      ]
    },
    "pull": {
      "name": "Upper Pull",
      "exercises": [
        {"name": "Lat Pull-down", "target_sets": 4, "target_reps": "8-10"},
        {"name": "Seated Cable Row", "target_sets": 4, "target_reps": "8-10"},
        {"name": "Straight-arm Pull-down", "target_sets": 3, "target_reps": "12"},
        {"name": "Incline Reverse Fly", "target_sets": 3, "target_reps": "12-15"},
        {"name": "Dumbbell Shrug", "target_sets": 3, "target_reps": "12-15"},
        {"name": "Dumbbell Biceps Curl", "target_sets": 3, "target_reps": "10-12"},
        {"name": "Hammer Curl", "target_sets": 3, "target_reps": "10-12"}
      ]
    },
    "arms_shoulders": {
      "name": "Arms & Shoulders",
      "exercises": [
        {"name": "Seated Dumbbell Shoulder Press", "target_sets": 4, "target_reps": "8-10"},
        {"name": "Dumbbell Lateral Raise", "target_sets": 4, "target_reps": "12-15"},
        {"name": "Incline Reverse Fly", "target_sets": 3, "target_reps": "12-15"},
        {"name": "EZ-Bar or Dumbbell Curl", "target_sets": 3, "target_reps": "8-10"},
        {"name": "Incline Dumbbell Curl", "target_sets": 3, "target_reps": "10-12"},
        {"name": "Triceps Press-down", "target_sets": 3, "target_reps": "10-12"},
        {"name": "Cable Overhead Triceps Extension", "target_sets": 3, "target_reps": "10-12"},
        {"name": "Goblet Squat (light legs)", "target_sets": 3, "target_reps": "12"},
        {"name": "Leg Curl (light legs)", "target_sets": 3, "target_reps": "12"},
        {"name": "Seated Calf Raise (light legs)", "target_sets": 3, "target_reps": "15"}
      ]
    },
    "abs_finisher": {
      "name": "Abs Finisher",
      "exercises": [
        {"name": "Hanging Leg Raise", "target_sets": 3, "target_reps": "15"},
        {"name": "Cable Crunch", "target_sets": 3, "target_reps": "15"},
        {"name": "Plank", "target_sets": 3, "target_reps": "60 sec"}
      ]
    }
  }
}
